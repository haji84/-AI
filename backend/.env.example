FIRE_AI_DATABASE_URL=postgresql+psycopg://fire_ai:CHANGE_ME@127.0.0.1:5432/fire_ai
FIRE_AI_SESSION_HOURS=12
FIRE_AI_COOKIE_SECURE=true
FIRE_AI_STORAGE_ROOT=/srv/fire-ai/storage

# Emergency report audit: Linux server; ordinary clients use the existing browser.
# Keep false until the server, source permissions and local acceptance are reviewed.
FIRE_AI_EMERGENCY_AUDIT_ENABLED=false
FIRE_AI_EMERGENCY_AUDIT_INTERNAL_ENABLED=false
FIRE_AI_EMERGENCY_AUDIT_KEY_FILE=
FIRE_AI_EMERGENCY_AUDIT_OCR_LANGUAGE=jpn+eng
# Optional separately provisioned local model. Empty means NOT_CONFIGURED.
FIRE_AI_EMERGENCY_AUDIT_AI_MODEL=
FIRE_AI_EMERGENCY_AUDIT_AI_PORT=11434
FIRE_AI_EMERGENCY_AUDIT_WORKER_TIMEOUT=600
# Read-only host checker / worker ExecStartPre; supplied and approved offline.
FIRE_AI_EMERGENCY_AUDIT_NATIVE_MANIFEST=
# Set a service-owned mode0700 directory on verified tmpfs in the service unit.
# TMPDIR=/run/fire-ai-emergency-audit
# Include this department's audit worker in FIRE_AI_BACKUP_WRITER_UNITS.
