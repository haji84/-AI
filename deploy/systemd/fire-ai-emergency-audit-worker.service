[Unit]
Description=Fire AI private emergency report worker
After=network-online.target fire-ai.service
Wants=network-online.target

[Service]
Type=simple
User=fire-ai
Group=fire-ai
WorkingDirectory=/opt/fire-ai/backend
EnvironmentFile=/etc/fire-ai/fire-ai.env
Environment=TMPDIR=/run/fire-ai-emergency-audit
RuntimeDirectory=fire-ai-emergency-audit
RuntimeDirectoryMode=0700
ExecStartPre=/opt/fire-ai/venv/bin/python /opt/fire-ai/scripts/check_emergency_audit_host.py
ExecStart=/opt/fire-ai/venv/bin/python /opt/fire-ai/scripts/run_emergency_audit_worker.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/fire-ai /var/lib/fire-ai /run/fire-ai-emergency-audit
UMask=0077

[Install]
WantedBy=multi-user.target
